
# StudyLens environment configuration
# Copy this file to .env in the repository root.

# Backend server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Additional CORS origins, comma-separated
ALLOWED_ORIGINS=http://localhost:5173

# Text limit is enforced in shared/src/contracts/api.ts
MAX_TEXT_LENGTH=5000

# AI configuration - not used until Phase 2
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# Persistence
# Raw text persistence is disabled by default.
ENABLE_REQUEST_HISTORY=false
